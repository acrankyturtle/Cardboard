<Project Sdk="Microsoft.NET.Sdk.Worker">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>dotnet-Cardboard.Controller-713aafc6-76e6-4750-9881-194a8894336d</UserSecretsId>
		<ApplicationIcon>..\react-frontend\public\key.ico</ApplicationIcon>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<OutputType>WinExe</OutputType>
	</PropertyGroup>
	<!-- Include wwwroot content in build output -->
	<ItemGroup>
		<Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.2" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.2" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.2" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Cardboard.Api\Cardboard.Api.csproj" />
		<ProjectReference Include="..\Cardboard.FrontendHost\Cardboard.FrontendHost.csproj" />
		<ProjectReference Include="..\Cardboard.Services\Cardboard.Services.csproj" />
		<ProjectReference Include="..\Cardboard.Update.Api\Cardboard.Update.Api.csproj" />
		<ProjectReference Include="..\Cardboard.Windows\Cardboard.Windows.csproj" />
	</ItemGroup>
	<!-- Copy bundled update server files to output -->
	<PropertyGroup>
		<UpdateServerFilesPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Cardboard.UpdateServer\files'))</UpdateServerFilesPath>
	</PropertyGroup>
	<Target Name="CopyBundledFiles" AfterTargets="Build">
		<ItemGroup>
			<BundledMetadataFiles Include="$(UpdateServerFilesPath)\metadata\**\*" />
			<BundledDeviceIconFiles Include="$(UpdateServerFilesPath)\device-icons\**\*" />
		</ItemGroup>
		<Copy
			SourceFiles="@(BundledMetadataFiles)"
			DestinationFiles="@(BundledMetadataFiles->'$(OutputPath)bundled\metadata\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true"
		/>
		<Copy
			SourceFiles="@(BundledDeviceIconFiles)"
			DestinationFiles="@(BundledDeviceIconFiles->'$(OutputPath)bundled\device-icons\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true"
		/>
	</Target>
	<!-- React Frontend Build (Release only) -->
	<PropertyGroup>
		<ReactProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\react-frontend'))</ReactProjectPath>
		<ReactBuildOutput>$(ReactProjectPath)\dist</ReactBuildOutput>
	</PropertyGroup>
	<Target Name="BuildReactFrontend" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<Message Text="Building React frontend..." Importance="High" />
		<Message Text="React project path: $(ReactProjectPath)" Importance="High" />
		<!-- Run npm install -->
		<Exec Command="npm install" WorkingDirectory="$(ReactProjectPath)" ConsoleToMsBuild="true" />
		<!-- Run npm build -->
		<Exec Command="npm run build" WorkingDirectory="$(ReactProjectPath)" ConsoleToMsBuild="true" />
	</Target>
	<Target
		Name="CopyReactToWwwroot"
		AfterTargets="BuildReactFrontend"
		Condition="'$(Configuration)' == 'Release'"
	>
		<Message Text="Copying React build output to wwwroot..." Importance="High" />
		<!-- Get all files from React dist folder -->
		<ItemGroup>
			<ReactDistFiles Include="$(ReactBuildOutput)\**\*" />
		</ItemGroup>
		<!-- Copy to wwwroot -->
		<Copy
			SourceFiles="@(ReactDistFiles)"
			DestinationFiles="@(ReactDistFiles-&gt;'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true"
		/>
	</Target>
</Project>
